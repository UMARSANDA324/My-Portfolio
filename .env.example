# Copy this file to .env and fill in the values.
# Vite requires custom environment variables to start with VITE_

# 1. Contact Form Feature (Explicit service/template/public key)
VITE_EMAILJS_CONTACT_SERVICE_ID=service_contact
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_contact
VITE_EMAILJS_CONTACT_PUBLIC_KEY=your_public_key_for_contact

# 2. AI Assistant Notifications (Explicit service/template/public key)
VITE_EMAILJS_AI_SERVICE_ID=service_ai
VITE_EMAILJS_AI_TEMPLATE_ID=template_ai
VITE_EMAILJS_AI_PUBLIC_KEY=your_public_key_for_ai

# 3. Collaboration Inquiries (Explicit service/template/public key)
VITE_EMAILJS_COLLAB_SERVICE_ID=service_collab
VITE_EMAILJS_COLLAB_TEMPLATE_ID=template_collab
VITE_EMAILJS_COLLAB_PUBLIC_KEY=your_public_key_for_collab

# NOTE: Legacy generic parameters (VITE_EMAILJS_SERVICE_ID, etc.) have been removed
# to ensure strict service isolation and prevent accidental routing to default dashboard accounts.
